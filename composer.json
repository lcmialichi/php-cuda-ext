{
    "name": "lcmialichi/php-gpu-tensors",
    "type": "php-ext",
    "description": "Native PHP extension for NVIDIA GPU tensors, CUDA-accelerated computing, and machine-learning workloads.",
    "license": "MIT",
    "keywords": [
        "php-extension",
        "cuda",
        "nvidia",
        "gpu-computing",
        "gpu-tensors",
        "tensors",
        "machine-learning",
        "tensor",
        "deep-learning",
        "numerical-computing"
    ],
    "autoload": {
        "psr-4": {
            "Benchmarks\\": "benchmarks/"
        }
    },
    "require": {
        "php": ">=8.1 <8.4"
    },
    "replace": {
        "ext-cuda": "*"
    },
    "php-ext": {
        "extension-name": "cuda",
        "support-zts": false,
        "os-families": [
            "linux"
        ],
        "configure-options": [
            {
                "name": "with-cuda",
                "description": "Path to the CUDA Toolkit installation, for example /usr/local/cuda.",
                "needs-value": true
            }
        ]
    }
}
